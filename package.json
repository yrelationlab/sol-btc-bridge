{
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "build": "anchor build -- --tools-version v1.41 -- -Znext-lockfile-bump",
    "test-in-remote-node": "anchor run test",
    "test-in-local": "anchor test -- --tools-version v1.41",
    "test-in-local-validator": "anchor test --skip-local-validator -- --tools-version v1.41 -- -Znext-lockfile-bump",
    "network": "solana config get",
    "url:local": "solana config set --url localhost",
    "url:dev": "env-cmd -f .env.devnet -x solana config set --url \\$RPC_URL",
    "url:test": "solana config set --url https://api.testnet.solana.com",
    "url:main": "env-cmd -f .env.mainnet -x solana config set --url \\$RPC_URL",
    "addr": "solana address -k ./cli/.config/secret.json",
    "balance": "solana balance -k ./cli/.config/secret.json",
    "airdrop": "solana airdrop 1000 -k ./cli/.config/secret.json",
    "node:local": "solana-test-validator --reset",
    "deploy:local": "solana program deploy target/deploy/bridge.so -k ./cli/.config/secret.json -u http://localhost:8899",
    "deploy:dev": "env-cmd -f .env.devnet -x anchor deploy --provider.cluster  \\$RPC_URL",
    "deploy:main": "env-cmd -f .env.mainnet -x anchor deploy --provider.cluster  \\$RPC_URL",
    "deploy:upgrade": "env-cmd -f .env.mainnet -x anchor upgrade --program-id 9q7cek9TaaRvExbAfKdAgUTzu92RvNTzCxVutXV1nDRC --provider.cluster \\$RPC_URL target/deploy/memoo.so",
    "deploy:test": "anchor deploy --provider.cluster testnet",
    "build:program-rust": "cargo build-bpf --manifest-path=./src/program-rust/Cargo.toml --bpf-out-dir=dist/program",
    "pgid": "solana address -k target/deploy/bridge-keypair.json",
    "clean": "cargo clean",
    "log": "solana logs",
    "kn": "kill -9 $(lsof -ti:8899) && kill -9 $(lsof -ti:9900)",
    "test": "./scripts/test-local.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@noble/ed25519": "^2.1.0",
    "@project-serum/serum": "^0.13.65",
    "@raydium-io/raydium-sdk": "1.1.0-beta.1",
    "@raydium-io/raydium-sdk-v2": "0.1.35-alpha",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.8",
    "bn.js": "^5.2.1",
    "borsh": "^0.7.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.5",
    "fs": "0.0.1-security",
    "json-bigint": "^1.0.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.16",
    "@types/expect": "24.3.0",
    "@types/node": "14.14.2",
    "chai": "^4.4.1",
    "env-cmd": "^10.1.0",
    "expect": "26.6.1",
    "husky": "4.3.0",
    "prettier": "^2.8.8",
    "tslint": "6.1.3",
    "typescript": "^4.9.5",
    "vitest": "^1.6.0",
    "wait-on": "^8.0.2"
  }
}
